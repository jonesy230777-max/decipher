# Decipher environment variables
# Copy to .env and fill in the blanks before starting.
# Never commit .env -- it contains secrets.

# -----------------------------------------------------------------------
# Ports (auto-assigned by scripts/find_ports.sh; override if needed)
# -----------------------------------------------------------------------
DECIPHER_DB_PORT=55432
DECIPHER_API_PORT=58080
DECIPHER_WEB_PORT=55173
DECIPHER_MAIL_PORT=58025

# -----------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------
POSTGRES_DB=decipher
POSTGRES_USER=decipher
POSTGRES_PASSWORD=change-me-in-prod

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod

# -----------------------------------------------------------------------
# Anthropic (Claude API)
# -----------------------------------------------------------------------
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------
# Leave blank to run in dev mode (Stripe calls return 503 and are bypassed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AUDIT_PRICE_AUD=497
STRIPE_SUCCESS_URL=http://localhost:55173/audit/start?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:55173/audit

# -----------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------
MAIL_FROM=audit@decipher.local

# -----------------------------------------------------------------------
# CORS (production only; leave blank for dev)
# -----------------------------------------------------------------------
# Set to your public domain, e.g.: https://decipher.com.au
DECIPHER_WEB_ORIGIN=
